# <site> dev environment.
#
# This file is the site's self-contained dev environment. It is a sampler:
# `python -m rhymes_with_soot.dev init <site>` writes a real `.env.dev`
# beside this file (with generated keys) and creates the dev account at
# `dev/users.json`. Every path below is relative to the repo root, which is
# also the cwd the dev server runs from.
#
# All dev state lives in this `dev/` directory so a dev server never touches
# the site's real (production) data.

SITE_TEMPLATE_SECRET_KEY=
SITE_TEMPLATE_ENCRYPTION_KEY=
SITE_TEMPLATE_DB_PATH=sites/<site>/dev/app.db
SITE_TEMPLATE_STORAGE_DIR=sites/<site>/dev/uploads
SITE_TEMPLATE_USERS_FILE=sites/<site>/dev/users.json

# Backend connections: add the site's own service vars here (e.g. an API
# base URL and key). Leave unset to run with no backend.
